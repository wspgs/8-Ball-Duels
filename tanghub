local function getActiveObjects()
	local foundInput = nil
	local foundMatch = nil
	for _, v in pairs(getgc(true)) do
		if type(v) == "table" then
			if not foundInput and rawget(v, "ShotBindable") and rawget(v, "Direction") and rawget(v, "Simulation") then
				foundInput = v
			end
			if not foundMatch and rawget(v, "AwaitingShot") ~= nil and rawget(v, "Simulation") and rawget(v, "Seat") then
