			end
			if foundInput and foundMatch then
				break
			end
		end
	end
	return foundInput, foundMatch
end

-- ================= 1. EXACT TRAJECTORY & LANDING SPOT TRACER =================
local function traceBallTrajectory(origin, dir)
	local bestDist = 9999
	local hitType = "Cushion"
	local hitPos = origin + dir * 100
	local targetPocket = nil

	-- 1. Check all 6 pockets
	for _, p in pairs(pockets) do
		local toMouth = p.MouthCentre - origin
		local dot = toMouth:Dot(dir)
		if dot > 0 then
			local perp = (toMouth - dir * dot).Magnitude
			local maxMouth = (p.Kind == "Side" and 2.7 or 2.35)
			if perp <= maxMouth and dot < bestDist then
				bestDist = dot
				hitType = "Pocket"
				hitPos = p.MouthCentre
				targetPocket = p
			end
		end
	end

	-- 2. If not pocket, find intersection with cushion walls
	if hitType ~= "Pocket" then
		local halfW = 44 - PoolConstants.BallRadius
		local halfH = 22 - PoolConstants.BallRadius
		local tX = 9999
		local tY = 9999

		if dir.X > 0.0001 then
			tX = (halfW - origin.X) / dir.X
		elseif dir.X < -0.0001 then
			tX = (-halfW - origin.X) / dir.X
		end
		if dir.Y > 0.0001 then
			tY = (halfH - origin.Y) / dir.Y
		elseif dir.Y < -0.0001 then
			tY = (-halfH - origin.Y) / dir.Y
		end

		local t = math.min(tX > 0 and tX or 9999, tY > 0 and tY or 9999)
		if t < bestDist then
			bestDist = t
			hitPos = origin + dir * t
			hitType = "Cushion"
		end
	end

	return hitType, hitPos, targetPocket, bestDist
end

