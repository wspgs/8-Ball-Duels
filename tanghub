local function computeBestShot(sim, rules, seat)
	if not sim or not sim.Balls then return nil end
	local cue = sim.Balls[PoolConstants.CueBallNumber]
	if not cue or cue.Pocketed then return nil end

	-- 1. LIVE BREAK SHOT (เปิดลูกแตกกระจาย เข้าหลุม 100%)
	local isBreakPhase = (rules and rules.Phase == "Break") or (sim and sim.IsBreakShot)
	if isBreakPhase then
		local cuePos = cue.Position
		local breakShot, pots = solveBreakShotLive(sim, cuePos)
		return breakShot
	end

	botProfile.CatchUp.Armed = false
	botProfile.CatchUp.Remaining = 0
	botProfile.Streak = 0

	local plan = PoolAI.Plan(botProfile, sim, rules, seat)
	if not plan then return nil end

	local cleanBankPots = {}
	local anyBankShots = {}
	local cleanDirectPots = {}
	local anyLegalPots = {}

	for _, c in ipairs(plan.Candidates or {}) do
		if c.Legal and not c.Scratches then
			if c.Bank then
				if c.Pots > 0 or c.Clean then
					table.insert(cleanBankPots, c)
				end
				table.insert(anyBankShots, c)
			else
				if c.Pots > 0 or c.Clean then
					table.insert(cleanDirectPots, c)
				end
			end
			table.insert(anyLegalPots, c)
		end
	end

	table.sort(cleanBankPots, function(a, b) return (a.Score or 0) > (b.Score or 0) end)
	table.sort(cleanDirectPots, function(a, b) return (a.Score or 0) > (b.Score or 0) end)
	table.sort(anyBankShots, function(a, b) return (a.Score or 0) > (b.Score or 0) end)
	table.sort(anyLegalPots, function(a, b) return (a.Score or 0) > (b.Score or 0) end)

	-- TRICKSHOT / BANK MODE WITH SMART FALLBACK:
	-- "อันไหนทำท่ายากได้ก็ทำ อันไหนทำไม่ได้ก็ทำให้ลงหลุม 100%"
	if Config.ShotStyle == "Trickshot / Bank (ท่ายาก ชิ่งช็อต)" then
		-- Priority 1: Bank shot that pots cleanly!
		if #cleanBankPots > 0 then
			return cleanBankPots[1]
		end
		-- Priority 2: Any clean direct pot (100% winrate fallback)
		if #cleanDirectPots > 0 then
			return cleanDirectPots[1]
		end
		-- Priority 3: Bank shot that contacts legally
		if #anyBankShots > 0 then
			return anyBankShots[1]
		end
		-- Priority 4: Any legal pot
		if #anyLegalPots > 0 then
			return anyLegalPots[1]
		end
	end

	-- DIRECT POT MODE (ชัวร์ 100% ไม่เล่นท่ายาก)
	if Config.ShotStyle == "Direct Pot (ชัวร์ 100% ไม่เล่นท่ายาก)" then
		if #cleanDirectPots > 0 then
			return cleanDirectPots[1]
		end
		if #cleanBankPots > 0 then
			return cleanBankPots[1]
		end
	end

	-- SMART AUTO:
	if #cleanDirectPots > 0 then
		return cleanDirectPots[1]
	elseif #cleanBankPots > 0 then
		return cleanBankPots[1]
	elseif #anyLegalPots > 0 then
		return anyLegalPots[1]
	end

	return plan.Choice
end

-- ================= 4. ULTRA-REALISTIC HUMANIZED SHOT EXECUTION =================
local isExecutingShot = false

local function performHumanizedShot(choice, inputObj, matchObj)
	if not choice or not inputObj then return false end

	local targetDir = choice.Direction.Unit
	local targetPower = math.clamp(choice.Power, 0.05, 1)

	-- 1. Human Thinking Delay (Randomized)
	if Config.Humanized and Config.ThinkingTime > 0 then
		local jitter = (math.random(-15, 20) / 100) * Config.ThinkingTime
		local delayTime = math.max(0.2, Config.ThinkingTime + jitter)
		task.wait(delayTime)
	end

	-- 2. Smooth Aim Rotation (หมุนไม้คิวนุ่มนวลเหมือนคนลากเมาส์เล็ง)
	if Config.Humanized and inputObj.Direction then
		local startDir = inputObj.Direction.Unit
		local steps = 15
		local stepTime = math.max(0.015, (Config.AimSmoothness or 0.4) / steps)

		for i = 1, steps do
			local alpha = i / steps
			local eased = 1 - (1 - alpha) ^ 3
			local curDir = PoolAI.SweepAim(startDir, targetDir, eased)
			PoolInputController.SetAimDirection(inputObj, curDir)
			task.wait(stepTime)
		end
	end

	PoolInputController.SetAimDirection(inputObj, targetDir)

	-- Pocket calling if match requires
	if matchObj and matchObj.Rules and PoolRules.NeedsCall(matchObj.Rules, matchObj.Simulation) then
		if choice.Pocket then
			matchObj.Call = choice.Pocket
		end
	end

	task.wait(0.06)

	-- 3. Smooth Power Pull (ค่อยๆ ดึงคันเกียร์พลังแบบคนแทงจริง)
	if Config.Humanized then
		local pullSteps = 9
		local pullStepTime = (Config.PowerSpeed or 0.35) / pullSteps
		for i = 1, pullSteps do
			local p = targetPower * (i / pullSteps)
			PoolInputController.SetPower(inputObj, p)
			task.wait(pullStepTime)
		end
		task.wait(math.random(12, 22) / 100)
	else
		PoolInputController.SetPower(inputObj, targetPower)
		task.wait(0.05)
	end

	-- 4. Release Shot
	if inputObj.ShotBindable then
		inputObj.ShotBindable:Fire(targetDir, targetPower, choice.Spin or Vector2.zero)
		return true
	end
	return false
end

-- Background Auto Play Runner
task.spawn(function()
	while true do
		task.wait(0.22)
		if Config.AutoPlay and not isExecutingShot then
			local inputObj, matchObj = getActiveObjects()

			if matchObj and matchObj.Replica and matchObj.Replica.Data then
				local pm = matchObj.Replica.Data.poolMatch
				local isMyTurn = pm and (pm.Phase == "Playing" or pm.Phase == "Break") and pm.Turn == matchObj.Seat
				local isSettled = matchObj.Simulation and matchObj.Simulation.Settled
				local isAwaiting = matchObj.AwaitingShot

				if isMyTurn and isSettled and not isAwaiting then
					isExecutingShot = true

					-- Handle Ball In Hand (วางลูกขาวจุดที่แทงง่ายที่สุดก่อน)
					if (matchObj.BallInHand or (inputObj and inputObj.State == "BallInHand")) and pm.Phase ~= "Break" then
						local placeOptions = PoolAI.PlaceCueBallOptions(botProfile, matchObj.Simulation, matchObj.Rules, 1)
						if placeOptions and placeOptions[1] then
							local cue = matchObj.Simulation.Balls[PoolConstants.CueBallNumber]
							if cue then
								cue.Position = PoolRules.ClampPlacement(matchObj.Rules, placeOptions[1].Spot or placeOptions[1])
							end
						end
						task.wait(0.35)
					end

					local bestChoice = computeBestShot(matchObj.Simulation, matchObj.Rules, matchObj.Seat)
					if bestChoice then
						performHumanizedShot(bestChoice, inputObj, matchObj)
					end

					task.wait(2.2)
					isExecutingShot = false
				end
			elseif inputObj and inputObj.State == "Aiming" and inputObj.Simulation and inputObj.Simulation.Settled then
				-- Solo / Bot / Practice mode
				isExecutingShot = true
				local bestChoice = computeBestShot(inputObj.Simulation, nil, 1)
				if bestChoice then
					performHumanizedShot(bestChoice, inputObj, nil)
				end
				task.wait(2.2)
				isExecutingShot = false
			end
		end
	end
end)

