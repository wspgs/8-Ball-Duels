autoPlayTab:addButton({
	Name = "Shoot Best Shot Now (กดแทงลูกทันที 1 ครั้ง)",
	Description = "สั่งให้คำนวณและแทงลูกเป้าที่ดีที่สุดทันทีในเทิร์นปัจจุบัน",
	Callback = function()
		local inputObj, matchObj = getActiveObjects()
		local sim = matchObj and matchObj.Simulation or (inputObj and inputObj.Simulation)
		local rules = matchObj and matchObj.Rules
		local seat = matchObj and matchObj.Seat or 1

		if sim and inputObj then
			local bestChoice = computeBestShot(sim, rules, seat)
			if bestChoice then
				performHumanizedShot(bestChoice, inputObj, matchObj)
				window:notify({
					Title = "Best Shot",
					Text = "แทงลูกหมายเลข " .. tostring(bestChoice.Target) .. " เรียบร้อย!",
					Duration = 3,
				})
			else
				window:notify({
					Title = "Notice",
					Text = "ไม่พบมุมหรือช็อตที่สามารถแทงได้ในขณะนี้",
					Duration = 3,
				})
			end
		else
			window:notify({
				Title = "Warning",
				Text = "ไม่พบโต๊ะหรือการแข่งขันที่กำลังเล่นอยู่",
				Duration = 3,
			})
		end
	end,
})

