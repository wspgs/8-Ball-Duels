local function fetch(url)
	local requested, response = pcall(request, { Url = url, Method = "GET" })
	if requested and type(response) == "table" and type(response.Body) == "string" and response.Body ~= "" then
		return response.Body, response.StatusCode
	end
	local fetched, body = pcall(function()
		return game:HttpGet(url)
	end)
	if fetched and type(body) == "string" and body ~= "" then
		return body, 200
	end
	return nil, requested and type(response) == "table" and response.StatusCode or tostring(response)
end

