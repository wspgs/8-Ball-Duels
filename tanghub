-- ================= 2. LIVE SIMULATION BREAK SOLVER (100% BREAK POT) =================
local function solveBreakShotLive(sim, cuePos)
	local bestShot = nil
	local maxPots = 0

	-- Live physics simulation sweep across rack
	for aimY = -0.5, 0.5, 0.03 do
		local simCopy = PoolPhysics.Clone(sim)
		simCopy.Balls[0].Position = cuePos
		local targetPos = Vector2.new(22.08, aimY)
		local dir = (targetPos - cuePos).Unit

		PoolPhysics.Shoot(simCopy, dir, 1.0, Vector2.new(0, 0.5))

		for step = 1, 260 do
			PoolPhysics.Step(simCopy, 0.0166)
			if simCopy.Settled then break end
		end

		local pots = 0
		for num, b in pairs(simCopy.Balls) do
			if b.Pocketed and num ~= 0 then
				pots = pots + 1
			end
		end
		local scratched = simCopy.Balls[0].Pocketed

		if not scratched and pots > maxPots then
			maxPots = pots
			bestShot = {
				Break = true,
				Direction = dir,
				Power = 1.0,
				Spin = Vector2.new(0, 0.5),
				Pots = pots,
				AimPoint = targetPos,
			}
		end
	end

	-- Fallback if no simulation hit: standard explosive break
	if not bestShot then
		bestShot = {
			Break = true,
			Direction = (Vector2.new(22.08, -0.2) - cuePos).Unit,
			Power = 1.0,
			Spin = Vector2.new(0, 0.5),
			Pots = 1,
			AimPoint = Vector2.new(22.08, -0.2),
		}
	end

	return bestShot, maxPots
end

